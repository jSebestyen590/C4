{
  "name": "@c4/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/local.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file-if-exists=.env.local src/db/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/dsql-signer": "^3.1146.0",
    "@c4/shared": "workspace:*",
    "@hono/aws-lambda": "^1.0.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "main": "./src/app.ts",
  "types": "./src/app.ts"
}
