{
  "name": "@c4/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/local.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file-if-exists=.env.local src/db/migrate-cli.ts",
    "reset": "tsx --env-file-if-exists=.env.local src/db/reset-cli.ts",
    "rollback": "tsx --env-file-if-exists=.env.local src/db/rollback-cli.ts",
    "seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@aws-sdk/dsql-signer": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@c4/shared": "workspace:*",
    "@hono/aws-lambda": "^1.0.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.11.0",
    "jose": "^6.2.12",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "main": "./src/app.ts",
  "types": "./src/app.ts"
}
