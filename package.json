{
  "name": "c4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @c4/api --filter @c4/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "bash infra/local-db/up.sh",
    "db:down": "bash infra/local-db/down.sh",
    "db:migrate": "pnpm --filter @c4/api migrate",
    "db:reset": "pnpm --filter @c4/api reset",
    "db:rollback": "pnpm --filter @c4/api rollback",
    "db:seed": "pnpm --filter @c4/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
